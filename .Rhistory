) |>
select(
student, Exam1, Exam2, Exam3, groupwork_total, pca_tot, podcast_tot, attend_adj, ec_tot, CurrentTotal,Cur100, everything()
) |>
filter(!str_detect(student, "Beauregard")) |>
filter(!str_detect(student, "Talbot")) |>
filter(!str_detect(student, "Student")) |>
mean(grades$Cur100)
hist(grades$Cur100)
library(stringr)
library(purrr)
library(tidyr)
library(dplyr)
library(here)
semesterFolder_Path <- "dev/PSY-209/S26-FinalGrades/"
here::i_am(paste0(semesterFolder_Path, "FinalGrades_PSY209_S26.R"))
grades <- read.csv(here::here(paste0(semesterFolder_Path, "psy209_canvas.csv")))
grades <- grades[-1,]
clean_names <- function(x) {
x |>
str_remove("\\.{2,}\\d+\\.?$") |>   # drop trailing ...185181.
str_replace_all("\\.{2,}", "") |>  # multiple dots → space
str_replace_all("\\.", "") |>      # single dots → space
str_replace_all("\\s+", "") |>     # collapse spaces
str_trim()
}
names(grades) <- clean_names(names(grades))
names(grades) <- names(grades) |>
str_replace("^Podcast (\\d+).*", "podcast_\\1") |>
str_replace("^Class (\\d+).*Exam (\\d+).*", "class_\\1_exam_\\2") |>
str_replace("^Class (\\d+).*", "class_\\1") |>
str_replace("^READ.*Chapter (\\d+).*", "reading_ch\\1") |>
str_replace_all(" ", "_") |>
tolower()
grades <-  grades |> select(-starts_with("readchapter"))
names(grades) <- names(grades) |>
str_replace("^(podcast\\d+).*", "\\1")
grades <- grades |>
rename(
groupwork_casestudyCwork = class21casestudyclasswork,
groupwork_peereval = grouppeerevaluationsrequired,
groupwork_present1 = class26firstsetofgrouppresentationsduetimeispresentationtime,
groupwork_present2 = class27secondsetofgrouppresentationsduetimeispresentationtime2,
groupwork_reading1 = abghsassignedreading,
groupwork_reading2 = ashasassignedreading,
groupwork_reading3 = mattsteamsassignedreading,
groupwork_reading4 = pandassassignedreading,
groupwork_reading5 = vdogsassignedreading,
groupwork_reading6 = psychedoutsassignedreading,
groupwork_reading7 = thesocialitessassignedreading,
groupwork_asynch = class11groupasynchronousshortactivity,
groupwork_naming = class5groupformationandname,
ec_evals = extracreditevals,
ec_talk = extracreditforsomeonecomingtomylibrarytalk,
pca_c1 = class1inclassassignment,
pca_c2 = class2inclassactivity,
pca_c3 = class3preclassassignment,
pca_c4 = byadddropintroduceyourself,
pca_c5 = class5preclassactivity,
pca_c6 = class6preclassactivity,
pca_c7 = class7inclassactivity,
pca_c8 = class11preclassactivity,
pca_c9 = class16preclassactivity,
pca_c10 = class19preclassactivity,
pcaI_1 = class20preclassassignmentindividual1,
pcaI_2 = class20preclassassignmentindividual2,
pcaI_3 = class20preclassassignmentindividual3,
pcaI_4 = class20preclassassignmentindividual4,
pcaI_5 = class20preclassassignmentindividual5,
pcaI_6 = class20preclassassignmentindividual6,
Exam1 = class12exam1,
Exam2 = class18exam2,
Exam3 = finalexamexam3,
groupwork_grouppres = class56inoutclassgroupactivityextended,
) %>%
mutate(across(starts_with("groupwork_reading"), ~na_if(.x, "N/A"))) %>%
mutate(groupwork_paper = coalesce(!!!select(., starts_with("groupwork_reading")))) %>%
mutate(across(starts_with("pcaI_"), ~na_if(.x, "N/A"))) %>%
mutate(pca_c11 = coalesce(!!!select(., starts_with("pcaI_")))) %>%
mutate(pca_c11 = as.numeric(pca_c11)) |>
select(-starts_with("groupwork_reading")) |>
select(-starts_with("pcaI_")) |>
select(-ends_with("currentscore"), -ends_with("finalscore"),
-ends_with("currentgrade"), -ends_with("finalgrade"),
-exam1unscaledgradeforinformationalpurposes, -exam2testcorrections) |>
mutate(across(starts_with("groupwork_present"), ~na_if(.x, "N/A"))) %>%
mutate(groupwork_present = coalesce(!!!select(., starts_with("groupwork_present")))) |>
mutate(groupwork_paper = as.numeric(groupwork_paper),
groupwork_present = as.numeric(groupwork_present)) |>
select(-groupwork_present1, -groupwork_present2) |>
select(student, id, sisloginid, sisuserid,
Exam1, Exam2, Exam3,
podcast1, podcast2, podcast3, podcast4, podcast5,
starts_with("pca_"), starts_with("groupwork_"),
starts_with("ec_"), starts_with("rollcall")
)
grades <- grades |>
rowwise() |>
mutate(
podcast_tot = {
x <- c_across(podcast1:podcast5)
x <- x[!is.na(x)]           # remove NAs
if (length(x) >= 4) {
sum(x[-which.min(x)])   # drop lowest, average rest
} else {
NA_real_                 # not enough scores
}
}
) |>
ungroup()
grades <- grades |>
mutate(
outof32 = rollcallattendance/100*32,
outof32add2 = outof32+2,
outof32add2 = ifelse(outof32add2>32, 32, outof32add2),
attend_adj = outof32add2/32*80,
groupwork_total = groupwork_paper + groupwork_peereval + groupwork_present + groupwork_casestudyCwork + groupwork_naming + groupwork_grouppres + groupwork_asynch,
pca_c12 = 1,
pca_tot = (pca_c1 + pca_c2 + pca_c3 + pca_c4 + pca_c5 + pca_c6 + pca_c7 + pca_c8 + pca_c9 + pca_c10 + pca_c11 + pca_c12)*10,
ec_tot = ec_talk + ec_evals
)  |>
mutate(
Exam1 = ifelse(student=="Student, Test", 160, Exam1),
Exam2 = ifelse(student=="Student, Test", 160, Exam2),
groupwork_total = ifelse(student=="Student, Test", 160, groupwork_total),
groupwork_total = ifelse(is.na(groupwork_total), 0, groupwork_total),
ec_tot = ifelse(is.na(ec_tot), 0, ec_tot),
pca_tot = ifelse(student=="Student, Test", 120, pca_tot),
podcast_tot = ifelse(student=="Student, Test", 160, podcast_tot),
attend_adj = ifelse(student=="Student, Test", 80, attend_adj)
) |>
mutate(
CurrentTotal = Exam1+Exam2+groupwork_total+pca_tot+podcast_tot+attend_adj+ec_tot,
Cur100 = round(CurrentTotal/8.4, 2)
) |>
select(
student, Exam1, Exam2, Exam3, groupwork_total, pca_tot, podcast_tot, attend_adj, ec_tot, CurrentTotal,Cur100, everything()
) |>
filter(!str_detect(student, "Beauregard")) |>
filter(!str_detect(student, "Talbot")) |>
filter(!str_detect(student, "Student"))
mean(grades$Cur100)
hist(grades$Cur100)
View(grades)
write.csv(grades, here::here(paste0(semesterFolder_Path, "PSY209-mailmerge.csv")))
