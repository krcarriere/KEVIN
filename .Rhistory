mutate(across(starts_with("groupwork_reading"), ~na_if(.x, "N/A"))) %>%
mutate(groupwork_paper = coalesce(!!!select(., starts_with("groupwork_reading")))) %>%
mutate(across(starts_with("pcaI_"), ~na_if(.x, "N/A"))) %>%
mutate(pca_c11 = coalesce(!!!select(., starts_with("pcaI_")))) %>%
mutate(pca_c11 = as.numeric(pca_c11)) |>
select(-starts_with("groupwork_reading")) |>
select(-starts_with("pcaI_")) |>
select(-ends_with("currentscore"), -ends_with("finalscore"),
-ends_with("currentgrade"), -ends_with("finalgrade"),
-exam1unscaledgradeforinformationalpurposes, -exam2testcorrections) |>
mutate(across(starts_with("groupwork_present"), ~na_if(.x, "N/A"))) %>%
mutate(groupwork_present = coalesce(!!!select(., starts_with("groupwork_present")))) |>
mutate(groupwork_paper = as.numeric(groupwork_paper),
groupwork_present = as.numeric(groupwork_present)) |>
select(-groupwork_present1, -groupwork_present2)
View(grades)
